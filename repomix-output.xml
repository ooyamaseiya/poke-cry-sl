        PIO_LIBRARIES: ${PIO_LIBRARIES:-m5stack/M5Unified}
        GITLEAKS_VERSION: ${GITLEAKS_VERSION:-8.30.0}
    volumes:
      - ..:/workspaces/${PROJECT_NAME:?PROJECT_NAME must be set}:cached
      # node_modules をコンテナ専用ボリュームにしてI/Oとリビルド時の再DLを高速化
      - node_modules:/workspaces/${PROJECT_NAME}/node_modules
      - ${HOST_CA_CERT_PATH:-/etc/caddy/certs/ca.crt}:/usr/local/share/ca-certificates/caddy-ca.crt:ro
    environment:
      NODE_EXTRA_CA_CERTS: /etc/ssl/certs/ca-certificates.crt
      REQUESTS_CA_BUNDLE: /etc/ssl/certs/ca-certificates.crt
      SSL_CERT_FILE: /etc/ssl/certs/ca-certificates.crt
      DISPLAY: :99
      XDG_RUNTIME_DIR: /tmp/runtime-${CONTAINER_USER:-root}
    ports:
      - "${APP_PORT:-5173}:${APP_PORT:-5173}"
      - "${NOVNC_PORT:-6080}:${NOVNC_PORT:-6080}"
    devices:
      # シリアルデバイスをホストからコンテナへパススルー（不要な場合は /dev/null 等で回避）
      - "${SERIAL_DEVICE:-/dev/null}:${SERIAL_DEVICE:-/dev/null}"
    user: "${CONTAINER_USER:-root}"
    command: sleep infinity
    extra_hosts:
      - "${INFER_HOST:-dev-infer.local}:${DEV_INFER_IP:?DEV_INFER_IP must be set}"

volumes:
  node_modules:
</file>

<file path=".devcontainer/initialize.sh">
#!/usr/bin/env bash
set -euo pipefail

ENV_FILE=".devcontainer/.env"
ENV_EXAMPLE_FILE=".devcontainer/.env.example"

# 1. .env が未作成で .env.example がある場合は初期コピー
if [[ ! -f "$ENV_FILE" && -f "$ENV_EXAMPLE_FILE" ]]; then
  cp "$ENV_EXAMPLE_FILE" "$ENV_FILE"
fi
touch "$ENV_FILE"

# 2. IPv4 名前解決ヘルパー（Linux / macOS 対応）
resolve_ipv4() {
  local host="$1"
  if command -v getent >/dev/null 2>&1; then
    getent ahostsv4 "$host" 2>/dev/null | awk '{print $1; exit}'
  elif command -v python3 >/dev/null 2>&1; then
    python3 -c "import socket; print(socket.gethostbyname('$host'))" 2>/dev/null || true
  fi
}

# 3. .env の特定キーだけを安全に更新・追記する関数（他の行は維持）
upsert_env() {
  local key="$1"
  local value="$2"
  local file="$3"

  awk -v k="$key" -v v="$value" '
    BEGIN { found = 0 }
    $0 ~ "^" k "=" { print k "=" v; found = 1; next }
    { print }
    END { if (!found) print k "=" v }
  ' "$file" > "${file}.tmp" && mv "${file}.tmp" "$file"
}

# 4. INFER_HOST の名前解決と .env への反映
# .env から INFER_HOST を取得、なければデフォルト値を使用
INFER_HOST=$(grep "^INFER_HOST=" "$ENV_FILE" | cut -d '=' -f2 || echo "dev-infer.local")
resolved_ip=$(resolve_ipv4 "$INFER_HOST")
resolved_ip="${resolved_ip:-127.0.0.1}"

upsert_env "DEV_INFER_IP" "$resolved_ip" "$ENV_FILE"
echo "[init] DEV_INFER_IP=${resolved_ip} (${INFER_HOST})"

# 5. OSに応じたデフォルトのCaddyルート証明書パスを設定
if [[ "$(uname -s)" == "Darwin" ]]; then
    DEFAULT_CERT_PATH="${HOME}/Library/Application Support/Caddy/pki/authorities/local/root.crt"
else
    DEFAULT_CERT_PATH="/etc/caddy/certs/ca.crt"
fi

# .env に HOST_CA_CERT_PATH が定義されていない、またはコメントアウトされている場合は追記
if ! grep -q "^HOST_CA_CERT_PATH=" "$ENV_FILE"; then
    upsert_env "HOST_CA_CERT_PATH" "$DEFAULT_CERT_PATH" "$ENV_FILE"
    echo "[init] HOST_CA_CERT_PATH auto-configured for $(uname -s)"
fi

# 6. プロジェクト名の動的設定
upsert_env "PROJECT_NAME" "${PROJECT_NAME:-$(basename "$PWD")}" "$ENV_FILE"

# 7. Git リポジトリ初期化済みの場合、ホスト側でも .githooks を有効化
if git rev-parse --is-inside-work-tree >/dev/null 2>&1 && [[ -d ".githooks" ]]; then
  chmod +x .githooks/* 2>/dev/null || true
  git config --local core.hooksPath .githooks
  echo "[init] Git hooks path configured to .githooks"
fi
</file>

<file path=".devcontainer/post-create.sh">
#!/usr/bin/env bash
set -euo pipefail

# 1. コンテナ起動時にマウントされたルート証明書をシステムに反映
if command -v sudo >/dev/null 2>&1; then
    sudo update-ca-certificates
else
    update-ca-certificates
fi

echo "[post-create] CA certificates updated successfully."

# 2. Git リポジトリ内で .githooks が存在する場合、gitleaks 用の pre-commit フックを有効化
if [[ -d ".githooks" ]]; then
    chmod +x .githooks/* 2>/dev/null || true

    # コンテナ実行ユーザーとホスト側ディレクトリ所有者が異なる場合の dubious ownership 対策
    if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
        git config --global --add safe.directory "$(pwd)" 2>/dev/null || true
    fi

    if git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
        git config --local core.hooksPath .githooks
        echo "[post-create] Git hooks path configured to .githooks (gitleaks pre-commit enabled)."
    else
        echo "[post-create] Warning: Not a git repository yet. Run 'git init && git config --local core.hooksPath .githooks' to enable gitleaks hook."
    fi
fi
</file>

